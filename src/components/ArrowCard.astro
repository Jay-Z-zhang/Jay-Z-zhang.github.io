---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";

type Props = {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog"> | CollectionEntry<"projects">;
};

const blogTags = entry.collection === "blog"
  ? (entry.data as CollectionEntry<"blog">["data"]).tags
  : undefined;
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="not-prose group block rounded-xl border border-border bg-secondary/20 overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-lg hover:shadow-primary/5"
>
  <div class="flex flex-col md:flex-row">
    {entry.data.image && (
      <div class="md:w-48 h-48 md:h-auto bg-secondary overflow-hidden flex-shrink-0">
        <img
          src={entry.data.image}
          alt={entry.data.title}
          loading="lazy"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </div>
    )}
    <div class="flex-1 p-5 space-y-2">
      <div class="flex items-start justify-between gap-3">
        <h3 class="font-semibold text-foreground group-hover:text-primary transition-colors">
          {entry.data.title}
        </h3>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="size-5 flex-shrink-0 text-muted-fg group-hover:text-primary transition-all duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
      <p class="text-sm text-muted-fg line-clamp-2">
        {entry.data.description}
      </p>
      <div class="flex items-center gap-3 pt-1">
        <div class="flex items-center gap-1.5 text-xs text-muted-fg">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <FormattedDate date={entry.data.date} />
        </div>
        {blogTags && blogTags.length > 0 && (
          <div class="flex items-center gap-1.5">
            {blogTags.slice(0, 3).map((tag) => (
              <span class="px-2 py-0.5 rounded-full bg-primary/10 text-primary text-xs font-medium">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</a>
