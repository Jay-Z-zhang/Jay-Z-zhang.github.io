---
type Props = {
  href: string;
};

const { href } = Astro.props;
---

<a
  href={href}
  class="group inline-flex items-center gap-1.5 text-sm text-muted-fg transition-colors duration-200 hover:text-primary"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="transition-transform duration-200 group-hover:-translate-x-0.5"
  >
    <polyline points="15 18 9 12 15 6"></polyline>
  </svg>
  <span><slot /></span>
</a>
