<div class="giscus rounded-xl border border-border bg-secondary/20 p-4"></div>

<script
  is:inline
  data-astro-rerun
  src="https://giscus.app/client.js"
  data-repo="trevortylerlee/astro-micro"
  data-repo-id="R_kgDOL_6l9Q"
  data-category="Announcements"
  data-category-id="DIC_kwDOL_6l9c4Cfk55"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="top"
  data-theme="preferred_color_scheme"
  data-lang="zh-CN"
  data-loading="lazy"
  crossorigin="anonymous"
  async></script>

<script is:inline>
  // Giscus 跟随主题切换
  function updateGiscusTheme() {
    const iframe = document.querySelector('iframe.giscus-frame');
    if (!iframe) return;
    const isLight = document.documentElement.classList.contains('light');
    iframe.contentWindow.postMessage({
      giscus: { setConfig: { theme: isLight ? 'light' : 'dark' } }
    }, 'https://giscus.app');
  }

  document.addEventListener('click', (e) => {
    if (e.target.closest('#theme-toggle')) {
      setTimeout(updateGiscusTheme, 300);
    }
  });

  document.addEventListener('astro:after-swap', () => {
    setTimeout(updateGiscusTheme, 500);
  });
</script>
