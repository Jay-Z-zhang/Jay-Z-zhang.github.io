---
const { prevPost, nextPost } = Astro.props;
---

<div class="grid grid-cols-2 gap-3 sm:gap-6">
  {
    prevPost?.id ? (
      <a
        href={`/blog/${prevPost?.id}`}
        rel="prefetch"
        class="group relative flex flex-nowrap rounded-lg border border-border bg-secondary/20 px-4 py-4 pl-10 text-muted-fg no-underline transition-colors duration-300 ease-in-out hover:border-primary/30 hover:text-primary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="absolute left-2.5 top-1/2 size-4 -translate-y-1/2 fill-none stroke-current stroke-2 pointer-events-none"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <div class="flex flex-col">
          <span class="text-xs text-muted-fg mb-1">上一篇</span>
          <div class="text-sm leading-snug">{prevPost?.data.title}</div>
        </div>
      </a>
    ) : (
      <div></div>
    )
  }

  {
    nextPost?.id ? (
      <a
        href={`/blog/${nextPost?.id}`}
        rel="prefetch"
        class="group relative flex grow flex-row-reverse flex-nowrap rounded-lg border border-border bg-secondary/20 px-4 py-4 pr-10 text-muted-fg no-underline transition-colors duration-300 ease-in-out hover:border-primary/30 hover:text-primary"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="absolute right-2.5 top-1/2 size-4 -translate-y-1/2 fill-none stroke-current stroke-2 pointer-events-none"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
        <div class="flex flex-col text-right">
          <span class="text-xs text-muted-fg mb-1">下一篇</span>
          <div class="text-sm leading-snug">{nextPost?.data.title}</div>
        </div>
      </a>
    ) : (
      <div></div>
    )
  }
</div>
