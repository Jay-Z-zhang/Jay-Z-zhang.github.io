<canvas id="binary-canvas" class="w-full block"></canvas>

<script is:inline>
(function() {
  var resizeHandler = null;
  var currentInstance = null;

  function tearDown() {
    if (!currentInstance) return;
    if (currentInstance.animFrameId) cancelAnimationFrame(currentInstance.animFrameId);
    if (currentInstance.observer) currentInstance.observer.disconnect();
    if (currentInstance.cleanup) currentInstance.cleanup();
    currentInstance = null;
  }

  function init() {
    var canvas = document.getElementById('binary-canvas');
    if (!canvas) return;

    Promise.all([
      document.fonts.ready,
      new Promise(function(r){ requestAnimationFrame(r); })
    ]).then(function(){
      tearDown();

      var ctx = canvas.getContext('2d');
      var dpr = window.devicePixelRatio || 1;

      // 严格按实际渲染宽度算,不再二值化
      var W = Math.max(320, Math.round(canvas.offsetWidth || 480));
      // 高度按比例,大屏也不超过视口 70%
      var H = Math.min(Math.round(W * 0.28), Math.round(window.innerHeight * 0.7));
      // 移动端(<640)双行版本,总高比略高
      var isNarrow = W < 640;
      if (isNarrow) H = Math.round(W * 0.55);

      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      ctx.scale(dpr, dpr);

      // 粒子间距: 屏越大间距略增但字号增长更快,视觉上不稀疏
      var spacing = Math.max(4, Math.round(W / 220));
      // 排斥半径按屏宽比例
      var pushRadius = Math.round(W * 0.055);
      var pushForce = 3;
      var springForce = 0.08;
      var friction = 0.85;

      var chars = '01';
      var particles = [];

      function getTextPixels(text, cx, cy, size) {
        var offscreen = document.createElement('canvas');
        offscreen.width = W;
        offscreen.height = H;
        var octx = offscreen.getContext('2d');
        octx.font = '900 ' + size + 'px "Arial Black", "Helvetica Neue", "Impact", sans-serif';
        octx.fillStyle = '#fff';
        octx.textAlign = 'center';
        octx.textBaseline = 'middle';
        octx.fillText(text, cx, cy);
        var imageData = octx.getImageData(0, 0, W, H);
        var pixels = [];
        for (var y = 0; y < H; y += spacing) {
          for (var x = 0; x < W; x += spacing) {
            var idx = (y * W + x) * 4;
            if (imageData.data[idx + 3] > 128) pixels.push({ x: x, y: y });
          }
        }
        return pixels;
      }

      var pixels1 = [], pixels2 = [];
      if (isNarrow) {
        // 两行:JAYZ / ZHANG
        var narrowFont = Math.round(W * 0.22);
        pixels1 = getTextPixels('JAYZ', W / 2, H * 0.38, narrowFont);
        pixels2 = getTextPixels('ZHANG', W / 2, H * 0.72, Math.round(narrowFont * 0.78));
      } else {
        // 单行:JAYZ ZHANG,字号严格按宽度比例(不再封顶)
        var wideFont = Math.round(W * 0.115);
        pixels1 = getTextPixels('JAYZ ZHANG', W / 2, H / 2, wideFont);
      }

      var addParticle = function(px) {
        particles.push({
          x: px.x, y: px.y,
          originX: px.x, originY: px.y,
          vx: 0, vy: 0,
          char: chars[Math.floor(Math.random() * 2)],
          baseAlpha: 0.3 + Math.random() * 0.7,
          alpha: 0,
          flicker: Math.random() < 0.08,
        });
      };
      pixels1.forEach(addParticle);
      pixels2.forEach(addParticle);

      // 噪点粒子:数量随画布面积连续变化,不再二值
      var noiseCount = Math.max(6, Math.floor((W * H) / 24000));
      var noiseParticles = [];
      for (var n = 0; n < noiseCount; n++) {
        noiseParticles.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.3,
          char: chars[Math.floor(Math.random() * 2)],
          alpha: 0.1 + Math.random() * 0.25,
          life: Math.floor(Math.random() * 200),
        });
      }

      // 主粒子字号按屏宽比例
      var pSize = Math.max(6, Math.round(W / 160));

      var mouseX = -999, mouseY = -999;
      function onMouseMove(e) {
        var rect = canvas.getBoundingClientRect();
        mouseX = (e.clientX - rect.left) * (W / rect.width);
        mouseY = (e.clientY - rect.top) * (H / rect.height);
      }
      function onMouseLeave() { mouseX = -999; mouseY = -999; }
      function onTouchMove(e) {
        e.preventDefault();
        var rect = canvas.getBoundingClientRect();
        mouseX = (e.touches[0].clientX - rect.left) * (W / rect.width);
        mouseY = (e.touches[0].clientY - rect.top) * (H / rect.height);
      }
      function onTouchEnd() { mouseX = -999; mouseY = -999; }
      function onContextMenu(e) { e.preventDefault(); }
      canvas.addEventListener('mousemove', onMouseMove);
      canvas.addEventListener('mouseleave', onMouseLeave);
      canvas.addEventListener('touchmove', onTouchMove, { passive: false });
      canvas.addEventListener('touchend', onTouchEnd);
      canvas.addEventListener('contextmenu', onContextMenu);

      var isLight = document.documentElement.classList.contains('light');
      var charColor = isLight ? '#15803d' : '#4ade80';

      var instance = { animFrameId: null };

      function animate() {
        ctx.clearRect(0, 0, W, H);
        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          var dx = p.x - mouseX;
          var dy = p.y - mouseY;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < pushRadius && dist > 0) {
            var force = (pushRadius - dist) / pushRadius * pushForce;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
          }
          p.vx += (p.originX - p.x) * springForce;
          p.vy += (p.originY - p.y) * springForce;
          p.vx *= friction;
          p.vy *= friction;
          p.x += p.vx;
          p.y += p.vy;
          if (Math.random() < 0.005) p.char = chars[Math.floor(Math.random() * 2)];
          if (p.flicker && Math.random() < 0.03) {
            p.alpha = Math.random() < 0.5 ? 0.1 : 1;
          } else {
            p.alpha = p.baseAlpha + (Math.random() - 0.5) * 0.15;
          }
          ctx.globalAlpha = p.alpha;
          ctx.fillStyle = charColor;
          ctx.font = pSize + 'px "Russo One", sans-serif';
          ctx.fillText(p.char, Math.round(p.x), Math.round(p.y));
        }
        for (var j = 0; j < noiseParticles.length; j++) {
          var np = noiseParticles[j];
          np.x += np.vx; np.y += np.vy; np.life++;
          if (np.x < 0 || np.x > W || np.y < 0 || np.y > H || np.life > 150 + Math.random() * 200) {
            np.x = Math.random() * W;
            np.y = Math.random() * H;
            np.vx = (Math.random() - 0.5) * 0.3;
            np.vy = (Math.random() - 0.5) * 0.3;
            np.life = 0;
            np.char = chars[Math.floor(Math.random() * 2)];
          }
          np.alpha = np.life < 20 ? np.life / 20 * 0.2 : np.life > 130 ? (150 - np.life) / 20 * 0.2 : 0.15 + Math.sin(np.life * 0.1) * 0.1;
          ctx.globalAlpha = Math.max(0, np.alpha);
          ctx.fillStyle = charColor;
          ctx.font = (pSize * 0.8) + 'px "Russo One", sans-serif';
          ctx.fillText(np.char, Math.round(np.x), Math.round(np.y));
        }
        ctx.globalAlpha = 1;
        instance.animFrameId = requestAnimationFrame(animate);
      }

      function startAnimation() {
        if (!instance.animFrameId) instance.animFrameId = requestAnimationFrame(animate);
      }
      function stopAnimation() {
        if (instance.animFrameId) {
          cancelAnimationFrame(instance.animFrameId);
          instance.animFrameId = null;
        }
      }

      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          entry.isIntersecting ? startAnimation() : stopAnimation();
        });
      }, { threshold: 0 });
      observer.observe(canvas);

      instance.observer = observer;
      instance.cleanup = function() {
        stopAnimation();
        canvas.removeEventListener('mousemove', onMouseMove);
        canvas.removeEventListener('mouseleave', onMouseLeave);
        canvas.removeEventListener('touchmove', onTouchMove);
        canvas.removeEventListener('touchend', onTouchEnd);
        canvas.removeEventListener('contextmenu', onContextMenu);
      };
      currentInstance = instance;

      startAnimation();
    });
  }

  function scheduleResize() {
    if (resizeHandler) clearTimeout(resizeHandler);
    resizeHandler = setTimeout(init, 200);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  window.addEventListener('resize', scheduleResize);
})();
</script>
