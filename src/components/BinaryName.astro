<canvas id="binary-canvas" class="w-full h-auto" style="max-width: 960px; display: block; margin: 0 auto;"></canvas>

<script is:inline>
(function() {
  var animFrameId = null;
  var observer = null;

  function init() {
    var canvas = document.getElementById('binary-canvas');
    if (!canvas) return;

    Promise.all([
      document.fonts.ready,
      new Promise(function(r) { requestAnimationFrame(r); })
    ]).then(function() {
      // Stop previous animation
      if (animFrameId) { cancelAnimationFrame(animFrameId); animFrameId = null; }
      if (observer) { observer.disconnect(); observer = null; }

      var ctx = canvas.getContext('2d');
      var dpr = window.devicePixelRatio || 1;

      var isWide = window.innerWidth >= 768;
      var containerW = canvas.parentElement ? canvas.parentElement.offsetWidth : window.innerWidth;
      var W = isWide ? Math.min(containerW, 960) : 480;
      var H = isWide ? Math.round(W * 0.3) : 240;
      canvas.width = W * dpr;
      canvas.height = H * dpr;
      canvas.style.width = W + 'px';
      canvas.style.height = H + 'px';
      canvas.style.maxWidth = '100%';
      ctx.scale(dpr, dpr);

      var chars = '01';
      var particles = [];
      var spacing = isWide ? 5 : 6;
      var pushRadius = isWide ? 65 : 40;
      var pushForce = 3;
      var springForce = 0.08;
      var friction = 0.85;

      function getTextPixels(text, cx, cy, size) {
        var offscreen = document.createElement('canvas');
        offscreen.width = W;
        offscreen.height = H;
        var octx = offscreen.getContext('2d');
        octx.font = '900 ' + size + 'px "Arial Black", "Helvetica Neue", "Impact", sans-serif';
        octx.fillStyle = '#fff';
        octx.textAlign = 'center';
        octx.textBaseline = 'middle';
        octx.fillText(text, cx, cy);
        var imageData = octx.getImageData(0, 0, W, H);
        var pixels = [];
        for (var y = 0; y < H; y += spacing) {
          for (var x = 0; x < W; x += spacing) {
            var idx = (y * W + x) * 4;
            if (imageData.data[idx + 3] > 128) {
              pixels.push({ x: x, y: y });
            }
          }
        }
        return pixels;
      }

      var pixels1 = [], pixels2 = [];
      if (isWide) {
        var fontSize = Math.min(135, W * 0.115);
        pixels1 = getTextPixels('JAYZ ZHANG', W / 2, H / 2, fontSize);
      } else {
        pixels1 = getTextPixels('JAYZ', W / 2, H * 0.38, 80);
        pixels2 = getTextPixels('ZHANG', W / 2, H * 0.72, 60);
      }

      pixels1.forEach(function(px) {
        particles.push({
          x: px.x, y: px.y,
          originX: px.x, originY: px.y,
          vx: 0, vy: 0,
          char: chars[Math.floor(Math.random() * 2)],
          baseAlpha: 0.3 + Math.random() * 0.7,
          alpha: 0,
          flicker: Math.random() < 0.08,
        });
      });
      pixels2.forEach(function(px) {
        particles.push({
          x: px.x, y: px.y,
          originX: px.x, originY: px.y,
          vx: 0, vy: 0,
          char: chars[Math.floor(Math.random() * 2)],
          baseAlpha: 0.3 + Math.random() * 0.7,
          alpha: 0,
          flicker: Math.random() < 0.08,
        });
      });

      var noiseCount = isWide ? 30 : 10;
      var noiseParticles = [];
      for (var n = 0; n < noiseCount; n++) {
        noiseParticles.push({
          x: Math.random() * W,
          y: Math.random() * H,
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.3,
          char: chars[Math.floor(Math.random() * 2)],
          alpha: 0.1 + Math.random() * 0.25,
          life: Math.floor(Math.random() * 200),
        });
      }

      var pSize = isWide ? 6 : 9;
      var mouseX = -999, mouseY = -999;
      var isLight = document.documentElement.classList.contains('light');
      var charColor = isLight ? '#15803d' : '#4ade80';

      canvas.onmousemove = function(e) {
        var rect = canvas.getBoundingClientRect();
        mouseX = (e.clientX - rect.left) * (W / rect.width);
        mouseY = (e.clientY - rect.top) * (H / rect.height);
      };
      canvas.onmouseleave = function() { mouseX = -999; mouseY = -999; };
      canvas.ontouchmove = function(e) {
        e.preventDefault();
        var rect = canvas.getBoundingClientRect();
        mouseX = (e.touches[0].clientX - rect.left) * (W / rect.width);
        mouseY = (e.touches[0].clientY - rect.top) * (H / rect.height);
      };
      canvas.ontouchend = function() { mouseX = -999; mouseY = -999; };
      canvas.oncontextmenu = function(e) { e.preventDefault(); };

      function animate() {
        ctx.clearRect(0, 0, W, H);

        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          var dx = p.x - mouseX;
          var dy = p.y - mouseY;
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < pushRadius && dist > 0) {
            var force = (pushRadius - dist) / pushRadius * pushForce;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
          }
          p.vx += (p.originX - p.x) * springForce;
          p.vy += (p.originY - p.y) * springForce;
          p.vx *= friction;
          p.vy *= friction;
          p.x += p.vx;
          p.y += p.vy;
          if (Math.random() < 0.005) {
            p.char = chars[Math.floor(Math.random() * 2)];
          }
          if (p.flicker && Math.random() < 0.03) {
            p.alpha = Math.random() < 0.5 ? 0.1 : 1;
          } else {
            p.alpha = p.baseAlpha + (Math.random() - 0.5) * 0.15;
          }
          ctx.globalAlpha = p.alpha;
          ctx.fillStyle = charColor;
          ctx.font = pSize + 'px "Russo One", sans-serif';
          ctx.fillText(p.char, Math.round(p.x), Math.round(p.y));
        }

        for (var j = 0; j < noiseParticles.length; j++) {
          var np = noiseParticles[j];
          np.x += np.vx;
          np.y += np.vy;
          np.life++;
          if (np.x < 0 || np.x > W || np.y < 0 || np.y > H || np.life > 150 + Math.random() * 200) {
            np.x = Math.random() * W;
            np.y = Math.random() * H;
            np.vx = (Math.random() - 0.5) * 0.3;
            np.vy = (Math.random() - 0.5) * 0.3;
            np.life = 0;
            np.char = chars[Math.floor(Math.random() * 2)];
          }
          np.alpha = np.life < 20 ? np.life / 20 * 0.2 : np.life > 130 ? (150 - np.life) / 20 * 0.2 : 0.15 + Math.sin(np.life * 0.1) * 0.1;
          ctx.globalAlpha = Math.max(0, np.alpha);
          ctx.fillStyle = charColor;
          ctx.font = (pSize * 0.8) + 'px "Russo One", sans-serif';
          ctx.fillText(np.char, Math.round(np.x), Math.round(np.y));
        }

        ctx.globalAlpha = 1;
        animFrameId = requestAnimationFrame(animate);
      }

      function startAnimation() {
        if (!animFrameId) animFrameId = requestAnimationFrame(animate);
      }
      function stopAnimation() {
        if (animFrameId) { cancelAnimationFrame(animFrameId); animFrameId = null; }
      }

      observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          entry.isIntersecting ? startAnimation() : stopAnimation();
        });
      }, { threshold: 0 });
      observer.observe(canvas);

      startAnimation();
    });
  }

  // Debounced resize
  var resizeTimer = null;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(init, 250);
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
