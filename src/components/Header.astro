---
import Container from "@components/Container.astro";
import { SITE } from "@consts";

type Props = {
  hasHero?: boolean;
};

const { hasHero = false } = Astro.props;
---

<header
  id="nav"
  class:list={[
    "fixed top-0 left-0 right-0 z-50 py-4 transition-all duration-300",
    !hasHero && "has-bg",
  ]}
>
  <div class="max-w-6xl mx-auto px-6 flex items-center justify-between">
    <a href="/" class="text-lg font-bold text-primary">
      {SITE.TITLE}
    </a>
    <div class="flex items-center gap-6">
      <a href="/" class="text-sm font-medium text-muted-fg hover:text-primary transition-colors">首页</a>
      <a href="/blog" class="text-sm font-medium text-muted-fg hover:text-primary transition-colors">博客</a>
      <a href="/projects" class="text-sm font-medium text-muted-fg hover:text-primary transition-colors">作品</a>
      <a
        href="https://github.com/Jay-Z-zhang"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-sm font-medium text-muted-fg hover:text-primary transition-colors"
        aria-label="GitHub"
      >
        <svg height="16" width="16" viewBox="0 0 16 16" fill="currentColor">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
        GitHub
      </a>
      <button
        id="magnifying-glass"
        aria-label="Search"
        class="flex items-center rounded-sm border border-border bg-secondary px-2 py-1 text-xs text-muted-fg transition-colors duration-300 ease-in-out hover:text-primary"
      >
        <svg height="14" stroke-linejoin="round" viewBox="0 0 16 16" width="14" style="color: currentcolor;">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  const nav = document.getElementById('nav');

  function isHomepage() {
    return window.location.pathname === '/' || window.location.pathname === '';
  }

  // 页面加载时：根据路径设置初始状态
  if (isHomepage()) {
    nav.classList.remove('has-bg');
  } else {
    nav.classList.add('has-bg');
  }

  // 滚动时动态控制
  window.addEventListener('scroll', function () {
    if (isHomepage()) {
      nav.classList.toggle('has-bg', window.scrollY > 20);
    } else {
      nav.classList.add('has-bg');
    }
  });
</script>
