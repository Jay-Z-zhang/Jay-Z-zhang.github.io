---
import Search from "astro-pagefind/components/Search";
---

<aside data-pagefind-ignore>
  <div
    transition:persist
    id="backdrop"
    class="invisible fixed left-0 top-0 z-50 flex h-screen w-full justify-center p-6"
    style="background: rgba(0,0,0,0.7); backdrop-filter: blur(8px);"
  >
    <div
      id="pagefind-container"
      class="m-0 flex h-fit max-h-[80%] w-full max-w-(--breakpoint-sm) flex-col overflow-auto rounded-xl border border-border bg-secondary p-2 px-4 py-3 shadow-lg"
    >
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          excerptLength: 15,
          resetStyles: false,
        }}
      />
      <div class="mr-2 pb-1 pt-4 text-right text-xs text-muted-fg">
        按 <kbd class="rounded border border-border bg-background px-1.5 py-0.5 text-xs">Esc</kbd> 关闭
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  const magnifyingGlass = document.getElementById("magnifying-glass");
  const backdrop = document.getElementById("backdrop");

  function openPagefind() {
    const searchDiv = document.getElementById("search");
    const search = searchDiv.querySelector("input");
    setTimeout(() => {
      search.focus();
    }, 0);
    backdrop?.classList.remove("invisible");
    backdrop?.classList.add("visible");
  }

  function closePagefind() {
    const search = document.getElementById("search");
    search.value = "";
    backdrop?.classList.remove("visible");
    backdrop?.classList.add("invisible");
  }

  magnifyingGlass?.addEventListener("click", () => {
    openPagefind();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "/") {
      e.preventDefault();
      openPagefind();
    } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openPagefind();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closePagefind();
    }
  });

  document.addEventListener("click", (event) => {
    if (event.target.classList.contains("pagefind-ui__result-link")) {
      closePagefind();
    }
  });

  backdrop?.addEventListener("click", (event) => {
    if (!event.target.closest("#pagefind-container")) {
      closePagefind();
    }
  });

  const form = document.getElementById("form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
  });
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 3px;
    --pagefind-ui-font: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", sans-serif;
    --pagefind-ui-primary: #22c55e;
    --pagefind-ui-text: #94a3b8;
    --pagefind-ui-background: #131928;
    --pagefind-ui-border: #1e293b;
    --pagefind-ui-tag: #1e293b;
  }

  #search input {
    font-weight: normal;
    background-color: #0b0f1a;
    color: #f1f5f9;
    border-color: #1e293b;
  }

  #search p {
    font-weight: normal;
    color: #94a3b8;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
    color: #f1f5f9;
  }

  #search .pagefind-ui__message {
    padding: 0;
    padding-bottom: 0.75rem;
    color: #64748b;
  }

  #search .pagefind-ui__result-extract {
    color: #94a3b8;
  }

  #search .pagefind-ui__result-extract mark {
    color: #22c55e;
    background: transparent;
  }
</style>
