---
import Layout from "@layouts/Layout.astro";
import { SITE, HOME } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION} noNavPadding={true}>

  <!-- ─────────── HERO ─────────── -->
  <section class="fluid-bg min-h-screen flex items-center relative overflow-hidden">
    <div class="absolute top-20 left-10 w-72 h-72 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-accent/5 rounded-full blur-3xl"></div>

    <div class="max-w-6xl mx-auto px-6 w-full grid md:grid-cols-2 gap-12 items-center relative z-10 pt-20">

      <!-- 文案 -->
      <div class="space-y-6 order-2 md:order-1">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-foreground leading-tight">
          张志
          <span class="block text-2xl md:text-3xl text-primary mt-2">Jayz Zhang</span>
        </h1>
        <div class="h-10 flex items-center">
          <span class="text-xl md:text-2xl text-accent" id="typewriter"></span>
          <span class="typewriter-cursor"></span>
        </div>
        <div class="flex gap-3 pt-4">
          <a href="/projects" class="px-6 py-3 rounded-lg bg-primary text-primary-fg font-medium text-sm hover:bg-primary/90 transition-colors">查看作品</a>
          <a href="https://github.com/Jay-Z-zhang" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-lg border border-border text-foreground font-medium text-sm hover:bg-secondary transition-colors inline-flex items-center gap-2">
            <svg height="16" width="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
        </div>
      </div>

      <!-- 头像 -->
      <div class="flex justify-center md:justify-start order-1 md:order-2">
        <img
          src="https://placehold.co/320x384/131928/4ade80?text=Jayz"
          alt="Jayz Zhang"
          class="w-72 h-80 md:w-80 md:h-96 rounded-2xl object-cover glow-border"
        >
      </div>

    </div>
  </section>

  <!-- ─────────── PROJECTS ─────────── -->
  <section id="projects" class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-3">项目作品</h2>
        <p class="text-muted-fg">我做过的产品和工具</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {projects.map((project) => (
          <a
            href={project.data.demoURL || `/projects/${project.id}`}
            target={project.data.demoURL ? "_blank" : undefined}
            rel={project.data.demoURL ? "noopener noreferrer" : undefined}
            class="block rounded-xl border border-border bg-secondary/20 overflow-hidden glow-border hover:border-primary/30 transition-all duration-300 group"
          >
            <!-- 项目配图 -->
            <div class="aspect-[16/10] bg-secondary overflow-hidden border-b border-border">
              <img
                src={`/images/${project.id}.svg`}
                alt={project.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src=`https://placehold.co/800x500/131928/22c55e?text=${encodeURIComponent(project.data.title)}`"
              >
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">
                {project.data.title}
              </h3>
              <p class="text-sm text-muted-fg leading-relaxed">
                {project.data.description}
              </p>
              <div class="flex items-center gap-2 text-sm text-primary pt-2">
                <span>打开项目</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/projects" class="text-sm text-primary hover:text-accent transition-colors">查看全部作品 →</a>
      </div>
    </div>
  </section>

  <!-- ─────────── BLOG ─────────── -->
  <section id="blog" class="py-24 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-background via-secondary/5 to-background pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-3">博客</h2>
        <p class="text-muted-fg">增长方法论、产品思考、AI 工具实践</p>
      </div>

      <ul class="not-prose flex flex-col gap-4 max-w-2xl mx-auto">
        {blog.map((post) => (
          <li class="animate">
            <ArrowCard entry={post} />
          </li>
        ))}
      </ul>

      <div class="text-center mt-10">
        <a href="/blog" class="text-sm text-primary hover:text-accent transition-colors">查看全部文章 →</a>
      </div>
    </div>
  </section>

  <!-- ─────────── GALLERY ─────────── -->
  <section id="about" class="py-24 relative">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-3">In Case You Wanna Know More</h2>
        <p class="text-muted-fg">个人志 · 生活的另一面</p>
      </div>

      <div class="space-y-16">
        <!-- 健身 -->
        <div class="scroll-section">
          <div class="flex items-center gap-3 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M14.4 14.4 9.6 9.6"/><path d="M18.657 21.485a2 2 0 1 1-2.829-2.828l-1.767 1.768a2 2 0 1 1-2.829-2.829l6.364-6.364a2 2 0 1 1 2.829 2.829l-1.768 1.767a2 2 0 1 1 2.828 2.829z"/><path d="m21.5 21.5-1.4-1.4"/><path d="M3.9 3.9 2.5 2.5"/><path d="M6.404 12.768a2 2 0 1 1-2.829-2.829l1.768-1.767a2 2 0 1 1-2.828-2.829l2.828-2.828a2 2 0 1 1 2.829 2.828l1.767-1.768a2 2 0 1 1 2.829 2.829z"/></svg>
            <h3 class="text-xl font-semibold text-foreground">健身</h3>
            <div class="flex-1 h-px bg-border"></div>
          </div>
          <div class="grid grid-cols-3 gap-4">
            <div class="rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 cursor-pointer group gallery-img-wrap">
              <img src="https://placehold.co/400x400/131928/4ade80?text=健身+1" alt="健身" class="w-full h-auto object-cover">
            </div>
            <div class="rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 cursor-pointer group gallery-img-wrap">
              <img src="https://placehold.co/400x400/131928/4ade80?text=健身+2" alt="健身" class="w-full h-auto object-cover">
            </div>
            <div class="rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 cursor-pointer group gallery-img-wrap">
              <img src="https://placehold.co/400x400/131928/4ade80?text=健身+3" alt="健身" class="w-full h-auto object-cover">
            </div>
          </div>
        </div>

        <!-- 旅游 -->
        <div class="scroll-section">
          <div class="flex items-center gap-3 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
            <h3 class="text-xl font-semibold text-foreground">旅游</h3>
            <div class="flex-1 h-px bg-border"></div>
          </div>
          <div class="grid grid-cols-3 gap-4">
            <div class="rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 cursor-pointer group gallery-img-wrap">
              <img src="https://placehold.co/400x400/131928/4ade80?text=旅游+1" alt="旅游" class="w-full h-auto object-cover">
            </div>
            <div class="rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 cursor-pointer group gallery-img-wrap">
              <img src="https://placehold.co/400x400/131928/4ade80?text=旅游+2" alt="旅游" class="w-full h-auto object-cover">
            </div>
            <div class="rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 cursor-pointer group gallery-img-wrap">
              <img src="https://placehold.co/400x400/131928/4ade80?text=旅游+3" alt="旅游" class="w-full h-auto object-cover">
            </div>
          </div>
        </div>

        <!-- 摄影 -->
        <div class="scroll-section">
          <div class="flex items-center gap-3 mb-6">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
            <h3 class="text-xl font-semibold text-foreground">摄影</h3>
            <div class="flex-1 h-px bg-border"></div>
          </div>
          <div class="grid grid-cols-3 gap-4">
            <div class="rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 cursor-pointer group gallery-img-wrap">
              <img src="https://placehold.co/400x400/131928/4ade80?text=摄影+1" alt="摄影" class="w-full h-auto object-cover">
            </div>
            <div class="rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 cursor-pointer group gallery-img-wrap">
              <img src="https://placehold.co/400x400/131928/4ade80?text=摄影+2" alt="摄影" class="w-full h-auto object-cover">
            </div>
            <div class="rounded-xl border border-border overflow-hidden hover:border-primary/30 transition-all duration-300 cursor-pointer group gallery-img-wrap">
              <img src="https://placehold.co/400x400/131928/4ade80?text=摄影+3" alt="摄影" class="w-full h-auto object-cover">
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  const phrases = [
    'Growth PM',
    '用 AI 重构工作方式',
    'Share & Referral',
  ];
  const el = document.getElementById('typewriter');
  if (!el) return;
  let phraseIdx = 0, charIdx = 0, deleting = false;

  function type() {
    const current = phrases[phraseIdx];
    if (!deleting) {
      el.textContent = current.slice(0, ++charIdx);
      if (charIdx === current.length) {
        setTimeout(() => { deleting = true; requestAnimationFrame(tick); }, 1800);
        return;
      }
    } else {
      el.textContent = current.slice(0, --charIdx);
      if (charIdx === 0) {
        deleting = false;
        phraseIdx = (phraseIdx + 1) % phrases.length;
        setTimeout(() => requestAnimationFrame(tick), 300);
        return;
      }
    }
    requestAnimationFrame(tick);
  }

  function tick() {
    setTimeout(type, deleting ? 40 : 80);
  }

  tick();
</script>
