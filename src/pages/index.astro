---
import Layout from "@layouts/Layout.astro";
import { SITE, HOME } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import BinaryName from "@components/BinaryName.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION} noNavPadding={true}>

  <!-- ─────────── HERO ─────────── -->
  <section class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden pt-20">
    <!-- Background glows -->
    <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-b from-background via-background to-secondary/20 pointer-events-none"></div>
    <div class="absolute top-20 left-1/4 w-96 h-96 bg-primary/3 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-20 right-1/4 w-80 h-80 bg-accent/3 rounded-full blur-[100px] pointer-events-none"></div>

    <!-- 全屏二进制粒子画布 -->
    <div class="relative z-10 w-full">
      <BinaryName />
    </div>

    <!-- 文案 + CTA 居中叠加在画布下方 -->
    <div class="relative z-10 text-center space-y-6 -mt-8 mb-8 px-4">
      <div class="h-8 flex items-center justify-center">
        <span class="text-lg md:text-xl text-accent font-medium" id="typewriter"></span>
        <span class="typewriter-cursor"></span>
      </div>

      <!-- 主 Value Prop -->
      <div class="space-y-2 max-w-2xl mx-auto">
        <h1 class="text-2xl md:text-3xl font-bold text-foreground tracking-tight">
          每周一封,增长产品经理的方法论深度信
        </h1>
        <p class="text-sm md:text-base text-muted-fg">
          Trip / TrainPal 一线增长实践,拆到能上手复用的颗粒度
        </p>
      </div>

      <!-- 订阅框 -->
      <form id="subscribe-form" class="max-w-md mx-auto" novalidate>
        <div class="flex gap-2 flex-col sm:flex-row">
          <input
            id="subscribe-email"
            type="email"
            required
            placeholder="your@email.com"
            autocomplete="email"
            class="flex-1 px-4 py-2.5 rounded-lg border border-border bg-secondary/40 text-foreground placeholder:text-muted-fg text-sm focus:outline-none focus:border-primary transition-colors"
          />
          <button
            type="submit"
            id="subscribe-btn"
            class="px-6 py-2.5 rounded-lg bg-primary text-primary-fg font-semibold text-sm hover:bg-primary/90 transition-all duration-200 hover:shadow-[0_0_20px_rgba(34,197,94,0.25)] whitespace-nowrap"
          >
            订阅深度信
          </button>
        </div>
        <div id="subscribe-msg" class="mt-3 text-xs text-muted-fg min-h-[1rem]">
          筹备中 · 前 100 位订阅者永久免费
        </div>
      </form>

      <!-- 次级 CTA -->
      <div class="flex items-center justify-center gap-4 text-sm pt-1">
        <a href="/blog" class="text-muted-fg hover:text-primary transition-colors">查看历史文章</a>
        <span class="text-border">·</span>
        <a href="/projects" class="text-muted-fg hover:text-primary transition-colors">查看作品</a>
      </div>
    </div>
    <!-- 下滑引导箭头 -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 scroll-guide">
      <a href="#projects" class="flex flex-col items-center gap-1 text-muted-fg hover:text-primary transition-colors duration-300">
        <span class="text-xs tracking-widest uppercase opacity-60">Scroll</span>
        <svg class="scroll-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </a>
    </div>
  </section>

  <!-- ─────────── PROJECTS ─────────── -->
  <section id="projects" class="py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-3">项目作品</h2>
        <p class="text-muted-fg">我做过的产品和工具</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        {projects.map((project) => (
          <a
            href={`/${project.id}/`}
            class="card-glow block overflow-hidden glow-border group"
          >
            <!-- 项目配图 -->
            <div class="aspect-[16/10] bg-secondary overflow-hidden border-b border-border">
              <img
                src={`/images/${project.id}.svg`}
                alt={project.data.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src=`https://placehold.co/800x500/131928/22c55e?text=${encodeURIComponent(project.data.title)}`"
              >
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">
                {project.data.title}
              </h3>
              <p class="text-sm text-muted-fg leading-relaxed">
                {project.data.description}
              </p>
              <div class="flex items-center gap-2 text-sm text-primary pt-2">
                <span>打开项目</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/projects" class="text-sm text-primary hover:text-accent transition-colors">查看全部作品 →</a>
      </div>
    </div>
  </section>

  <!-- ─────────── BLOG ─────────── -->
  <section id="blog" class="py-20 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-background via-secondary/5 to-background pointer-events-none"></div>
    <div class="max-w-6xl mx-auto px-6 relative z-10">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-foreground mb-3">博客</h2>
        <p class="text-muted-fg">增长方法论、产品思考、AI 工具实践</p>
      </div>

      <ul class="not-prose flex flex-col gap-4 max-w-2xl mx-auto">
        {blog.map((post) => (
          <li class="animate">
            <ArrowCard entry={post} />
          </li>
        ))}
      </ul>

      <div class="text-center mt-10">
        <a href="/blog" class="text-sm text-primary hover:text-accent transition-colors">查看全部文章 →</a>
      </div>
    </div>
  </section>

</Layout>

<script is:inline>
  // 打字机 - 展示 newsletter 会讲哪些主题,而非抽象口号
  const phrases = [
    'LTV/CAC 到底怎么算才不骗自己',
    '海外增长:Reddit / Twitter / ProductHunt',
    '融资估值背后的真实逻辑',
    '增长实验平台从 0 到 1',
    'ATS 简历怎么写才不被过滤',
  ];

  function initTypewriter() {
    const el = document.getElementById('typewriter');
    if (!el) return;
    // 防重复:soft-nav 会再次触发 init,dataset 保证只跑一次
    if (el.dataset.bound === '1') return;
    el.dataset.bound = '1';
    let phraseIdx = 0, charIdx = 0, deleting = false;

    function type() {
      // el 已从 DOM 移除 → 停止(soft-nav 场景)
      if (!el.isConnected) return;
      const current = phrases[phraseIdx];
      if (!deleting) {
        el.textContent = current.slice(0, ++charIdx);
        if (charIdx === current.length) {
          setTimeout(() => { deleting = true; type(); }, 1800);
          return;
        }
      } else {
        el.textContent = current.slice(0, --charIdx);
        if (charIdx === 0) {
          deleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          setTimeout(type, 300);
          return;
        }
      }
      setTimeout(type, deleting ? 40 : 80);
    }

    type();
  }

  document.addEventListener('DOMContentLoaded', initTypewriter);
  document.addEventListener('astro:after-swap', initTypewriter);

  // 订阅表单
  const WORKER_URL = 'https://api.jayzzhang.online';
  function initSubscribe() {
    const form = document.getElementById('subscribe-form');
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';
    const btn = document.getElementById('subscribe-btn');
    const input = document.getElementById('subscribe-email');
    const msg = document.getElementById('subscribe-msg');
    const originalMsg = msg ? msg.textContent : '';

    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      const email = (input.value || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        msg.textContent = '邮箱格式不正确';
        msg.style.color = '#f87171';
        return;
      }
      const originalBtnText = btn.textContent;
      btn.disabled = true;
      btn.textContent = '订阅中...';
      msg.style.color = '';
      msg.textContent = originalMsg;

      const controller = new AbortController();
      const timeoutId = setTimeout(function(){ controller.abort(); }, 10000);
      try {
        const res = await fetch(WORKER_URL + '/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, source: 'homepage' }),
          signal: controller.signal,
        });
        clearTimeout(timeoutId);
        const data = await res.json().catch(function(){ return {}; });
        if (!res.ok || !data.ok) {
          msg.textContent = (data && data.error) || '订阅失败,请稍后再试';
          msg.style.color = '#f87171';
          btn.disabled = false;
          btn.textContent = originalBtnText;
          return;
        }
        // 成功
        form.innerHTML =
          '<div style="text-align:center;padding:14px 16px;border:1px solid var(--color-border);border-radius:10px;background:rgba(34,197,94,0.06);">' +
            '<div style="color:var(--color-primary);font-weight:600;font-size:14px;">已收到,感谢你的信任</div>' +
            '<div style="color:var(--color-muted-fg);font-size:12px;margin-top:6px;">第 ' + (data.total || '') + ' 位订阅者。第一封信发出时会通知你。</div>' +
          '</div>';
      } catch (err) {
        clearTimeout(timeoutId);
        const isNet = err.name === 'AbortError' || /Failed to fetch|NetworkError|ERR_TIMED_OUT/i.test(err.message || '');
        msg.textContent = isNet
          ? '网络异常,试试切换热点后重试'
          : '订阅失败: ' + (err.message || '未知错误');
        msg.style.color = '#f87171';
        btn.disabled = false;
        btn.textContent = originalBtnText;
      }
    });
  }
  document.addEventListener('DOMContentLoaded', initSubscribe);
  document.addEventListener('astro:after-swap', initSubscribe);
</script>
