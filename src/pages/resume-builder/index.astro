---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
---

<Layout title="简历生成器" description="多模板在线简历工具 — 实时预览、AI 润色、一键导出 PDF">
  <Container>
    <div class="flex items-center gap-3 mb-10 pt-8">
      <BackToPrevious href="/projects">返回作品</BackToPrevious>
    </div>

    <!-- ═══ HERO ═══ -->
    <section class="relative py-12">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-primary/4 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="relative z-10">
        <div class="flex items-center gap-2 mb-5">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            产品工具
          </span>
          <span class="text-[11px] font-medium text-muted-fg bg-secondary/60 px-3 py-1 rounded-full border border-border">效率工具</span>
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-foreground leading-tight tracking-tight mb-5">
          简历生成器
        </h1>
        <p class="text-lg text-muted-fg leading-relaxed max-w-xl">
          左侧编辑、右侧实时预览。支持 4 套模板、AI 润色建议、一键导出 PDF，让写简历回归内容本身。
        </p>
      </div>
    </section>

    <!-- ═══ 功能亮点 ═══ -->
    <section class="py-12 border-t border-border/40">
      <div class="grid md:grid-cols-2 gap-x-8 gap-y-6">
        <div class="flex gap-4">
          <div class="w-9 h-9 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-foreground mb-1">4 套模板 · 10 种主题色</h3>
            <p class="text-xs text-muted-fg leading-relaxed">极简黑白、蓝色现代、深色强调、双栏布局，一键切换风格</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="w-9 h-9 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-foreground mb-1">AI 润色建议</h3>
            <p class="text-xs text-muted-fg leading-relaxed">基于 DeepSeek，从 STAR 法则、ATS 关键词、语法拼写、岗位匹配四个维度给出建议</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="w-9 h-9 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-foreground mb-1">8 种字体 · 逐层微调</h3>
            <p class="text-xs text-muted-fg leading-relaxed">思源黑体、Inter、DM Sans 等，字号颜色逐层调整</p>
          </div>
        </div>

        <div class="flex gap-4">
          <div class="w-9 h-9 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-foreground mb-1">一键导出 PDF / HTML</h3>
            <p class="text-xs text-muted-fg leading-relaxed">打印级 PDF 导出，或下载独立 HTML 文件随时编辑</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 使用场景 ═══ -->
    <section class="py-12 border-t border-border/40">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[11px] font-semibold tracking-widest text-muted-fg uppercase">使用场景</span>
        <div class="flex-1 h-px bg-border/50"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-xl border border-border bg-secondary/20 p-5">
          <div class="text-[11px] font-bold text-primary/60 font-mono mb-2">01</div>
          <h3 class="text-sm font-semibold text-foreground mb-1.5">求职投递</h3>
          <p class="text-xs text-muted-fg leading-relaxed">快速生成专业简历，针对岗位调整内容和模板</p>
        </div>
        <div class="rounded-xl border border-border bg-secondary/20 p-5">
          <div class="text-[11px] font-bold text-primary/60 font-mono mb-2">02</div>
          <h3 class="text-sm font-semibold text-foreground mb-1.5">中英双语</h3>
          <p class="text-xs text-muted-fg leading-relaxed">一键切换中英文界面，外企/海外求职无缝适配</p>
        </div>
        <div class="rounded-xl border border-border bg-secondary/20 p-5">
          <div class="text-[11px] font-bold text-primary/60 font-mono mb-2">03</div>
          <h3 class="text-sm font-semibold text-foreground mb-1.5">作品集展示</h3>
          <p class="text-xs text-muted-fg leading-relaxed">下载 HTML 嵌入个人网站，作为交互式作品集</p>
        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="py-16 border-t border-border/40">
      <div class="text-center space-y-5">
        <h2 class="text-2xl font-bold text-foreground">开始制作你的简历</h2>
        <p class="text-sm text-muted-fg max-w-md mx-auto">填写信息 → 选择模板 → AI 润色 → 导出 PDF，全程不超过 10 分钟。</p>
        <div class="flex items-center justify-center gap-3 pt-2">
          <a href="/apps/resume-builder/" class="inline-flex items-center gap-2 px-7 py-2.5 rounded-lg bg-primary text-primary-fg text-sm font-semibold hover:bg-primary/90 transition-all duration-200 hover:shadow-[0_0_16px_rgba(34,197,94,0.3)]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            打开工具
          </a>
          <a href="https://github.com/Jay-Z-zhang" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border text-foreground text-sm font-medium hover:bg-secondary hover:border-primary/20 transition-all duration-200">
            <svg height="14" width="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
        </div>
      </div>
    </section>
  </Container>
</Layout>
