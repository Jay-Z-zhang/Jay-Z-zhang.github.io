---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
---

<Layout title="裂变漏斗计算器" description="增长 PM 必备工具 — 快速估算裂变活动 ROI、K 因子、获客成本">
  <Container>
    <div class="mb-6">
      <BackToPrevious href="/projects">← 返回作品</BackToPrevious>
    </div>

    <!-- 项目说明 -->
    <div class="py-12 space-y-8">
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <span class="text-xs font-medium text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20">产品工具</span>
          <span class="text-xs font-medium text-muted-fg bg-secondary px-3 py-1 rounded-full border border-border">Growth PM</span>
        </div>
        <h1 class="text-4xl font-bold text-foreground">裂变漏斗计算器</h1>
        <p class="text-xl text-muted-fg leading-relaxed">一个帮你在活动设计阶段就能预估效果的在线计算器，支持 K 因子、转化率、获客成本等核心指标的实时计算。</p>
      </div>

      <!-- 核心功能 -->
      <div class="grid md:grid-cols-3 gap-4">
        <div class="rounded-xl border border-border bg-secondary/20 p-5 space-y-2">
          <div class="text-2xl">📊</div>
          <h3 class="text-sm font-semibold text-foreground">K 因子实时计算</h3>
          <p class="text-xs text-muted-fg">分享率 × 传播人数 × 助力率 × 新客转化率，一目了然</p>
        </div>
        <div class="rounded-xl border border-border bg-secondary/20 p-5 space-y-2">
          <div class="text-2xl"></div>
          <h3 class="text-sm font-semibold text-foreground">ROI 敏感性分析</h3>
          <p class="text-xs text-muted-fg">调整任意参数，实时看 ROI 和获客成本的变化</p>
        </div>
        <div class="rounded-xl border border-border bg-secondary/20 p-5 space-y-2">
          <div class="text-2xl">⚖️</div>
          <h3 class="text-sm font-semibold text-foreground">裂变 vs 广告对比</h3>
          <p class="text-xs text-muted-fg">对比两种获客渠道的 CAC 和 ROI，辅助预算决策</p>
        </div>
      </div>

      <!-- 使用场景 -->
      <div class="rounded-xl border border-border bg-secondary/20 p-6 space-y-4">
        <h2 class="text-lg font-semibold text-foreground">使用场景</h2>
        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <span class="text-primary font-bold text-sm mt-0.5">01</span>
            <div>
              <p class="text-sm text-foreground font-medium">活动方案评审</p>
              <p class="text-xs text-muted-fg">快速验证数字是否合理，避免上线后发现 ROI 算不过来</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-primary font-bold text-sm mt-0.5">02</span>
            <div>
              <p class="text-sm text-foreground font-medium">活动复盘对比</p>
              <p class="text-xs text-muted-fg">对比预估 vs 实际数据，优化下次活动模型</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="text-primary font-bold text-sm mt-0.5">03</span>
            <div>
              <p class="text-sm text-foreground font-medium">向上汇报</p>
              <p class="text-xs text-muted-fg">用数据说话，给老板展示活动的预期收益和回本周期</p>
            </div>
          </div>
        </div>
      </div>

      <!-- GitHub 链接 -->
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/Jay-Z-zhang"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-primary text-primary-fg text-sm font-medium hover:bg-primary/90 transition-colors"
        >
          <svg height="16" width="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          GitHub 源码
        </a>
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border text-foreground text-sm font-medium hover:bg-secondary transition-colors"
        >
          查看全部作品
        </a>
      </div>
    </div>

    <!-- 分隔线 -->
    <div class="h-px bg-border"></div>

    <!-- 计算器嵌入 -->
    <div class="py-12">
      <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-foreground">🔁 在线体验</h2>
        <p class="text-sm text-muted-fg mt-2">拖动滑块调整参数，实时查看漏斗效果和核心指标</p>
      </div>
      <div class="rounded-xl border border-border bg-secondary/20 overflow-hidden">
        <iframe
          src="/apps/viral-calculator/"
          class="w-full"
          style="height: 2400px; border: none;"
          title="裂变漏斗计算器"
        ></iframe>
      </div>
    </div>
  </Container>
</Layout>
