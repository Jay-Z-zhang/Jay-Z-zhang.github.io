---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
---

<Layout title="裂变漏斗计算器" description="增长 PM 必备工具 — 快速估算裂变活动 ROI、K 因子、获客成本">
  <Container>
    <div class="flex items-center gap-3 mb-8 pt-8">
      <Breadcrumb />
    </div>

    <!-- ═══ HERO ═══ -->
    <section class="relative py-14">
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-primary/4 rounded-full blur-[120px] pointer-events-none"></div>

      <div class="relative z-10">
        <div class="flex items-center gap-2 mb-5">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            产品工具
          </span>
          <span class="text-[11px] font-medium text-muted-fg bg-secondary/60 px-3 py-1 rounded-full border border-border">Growth PM</span>
        </div>

        <h1 class="hero-title mb-4">
          裂变漏斗计算器
        </h1>
        <p class="text-base md:text-lg text-muted-fg leading-relaxed max-w-2xl">
          活动设计阶段就能预估效果——输入 DAU、分享率、转化率，实时计算 K 因子、CAC 和 ROI，辅助预算决策。
        </p>
      </div>
    </section>

    <!-- ═══ 核心指标 ══ -->
    <section class="py-10 border-t border-border/40">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="rounded-xl border border-border/60 bg-secondary/30 p-5 text-center">
          <div class="text-3xl font-extrabold text-primary font-mono">K</div>
          <div class="text-xs text-muted-fg mt-1.5">K 因子</div>
        </div>
        <div class="rounded-xl border border-border/60 bg-secondary/30 p-5 text-center">
          <div class="text-3xl font-extrabold text-primary font-mono">CAC</div>
          <div class="text-xs text-muted-fg mt-1.5">获客成本</div>
        </div>
        <div class="rounded-xl border border-border/60 bg-secondary/30 p-5 text-center">
          <div class="text-3xl font-extrabold text-primary font-mono">ROI</div>
          <div class="text-xs text-muted-fg mt-1.5">投入产出比</div>
        </div>
        <div class="rounded-xl border border-border/60 bg-secondary/30 p-5 text-center">
          <div class="text-3xl font-extrabold text-primary font-mono">GMV</div>
          <div class="text-xs text-muted-fg mt-1.5">交易总额</div>
        </div>
      </div>
    </section>

    <!-- ═══ 功能亮点 ═══ -->
    <section class="py-10 border-t border-border/40">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[11px] font-semibold tracking-widest text-muted-fg uppercase">功能亮点</span>
        <div class="flex-1 h-px bg-border/50"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <div class="rounded-xl border border-border/60 bg-secondary/20 p-6 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          </div>
          <h3 class="text-sm font-semibold text-foreground">K 因子实时计算</h3>
          <p class="text-xs text-muted-fg leading-relaxed">分享率 × 传播人数 × 助力率 × 转化率，拖动滑块即可看到 K 因子的实时变化</p>
        </div>

        <div class="rounded-xl border border-border/60 bg-secondary/20 p-6 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3 class="text-sm font-semibold text-foreground">ROI 敏感性分析</h3>
          <p class="text-xs text-muted-fg leading-relaxed">调整任意参数，实时查看 ROI 和获客成本的变化，快速定位最优方案</p>
        </div>

        <div class="rounded-xl border border-border/60 bg-secondary/20 p-6 space-y-3">
          <div class="w-10 h-10 rounded-lg bg-primary/10 border border-primary/20 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
          </div>
          <h3 class="text-sm font-semibold text-foreground">裂变 vs 广告对比</h3>
          <p class="text-xs text-muted-fg leading-relaxed">对比两种获客渠道的 CAC 和 ROI，用数据辅助预算分配决策</p>
        </div>
      </div>
    </section>

    <!-- ═══ 使用场景 ══ -->
    <section class="py-10 border-t border-border/40">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-[11px] font-semibold tracking-widest text-muted-fg uppercase">使用场景</span>
        <div class="flex-1 h-px bg-border/50"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <div class="rounded-xl border border-border/60 bg-secondary/20 p-6">
          <div class="text-[11px] font-bold text-primary/60 font-mono mb-3">01</div>
          <h3 class="text-sm font-semibold text-foreground mb-2">活动方案评审</h3>
          <p class="text-xs text-muted-fg leading-relaxed">快速验证数字是否合理，避免上线后才发现 ROI 算不过来</p>
        </div>
        <div class="rounded-xl border border-border/60 bg-secondary/20 p-6">
          <div class="text-[11px] font-bold text-primary/60 font-mono mb-3">02</div>
          <h3 class="text-sm font-semibold text-foreground mb-2">活动复盘对比</h3>
          <p class="text-xs text-muted-fg leading-relaxed">对比预估 vs 实际数据，找到偏差原因，优化下次活动模型</p>
        </div>
        <div class="rounded-xl border border-border/60 bg-secondary/20 p-6">
          <div class="text-[11px] font-bold text-primary/60 font-mono mb-3">03</div>
          <h3 class="text-sm font-semibold text-foreground mb-2">向上汇报</h3>
          <p class="text-xs text-muted-fg leading-relaxed">用数据说话，给老板展示活动的预期收益和回本周期</p>
        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="py-14 border-t border-border/40">
      <div class="text-center space-y-5">
        <h2 class="text-2xl font-bold text-foreground">计算你的裂变效果</h2>
        <p class="text-sm text-muted-fg max-w-md mx-auto">输入 DAU、分享率、转化率等参数，实时查看 K 因子、CAC 和 ROI，全程不超过 5 分钟。</p>
        <div class="flex items-center justify-center gap-3 pt-2">
          <a href="/apps/viral-calculator/" class="inline-flex items-center gap-2 px-7 py-2.5 rounded-lg bg-primary text-primary-fg text-sm font-semibold hover:bg-primary/90 transition-all duration-200 hover:shadow-[0_0_16px_rgba(34,197,94,0.3)]">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
            打开工具
          </a>
          <a href="https://github.com/Jay-Z-zhang" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-border text-foreground text-sm font-medium hover:bg-secondary hover:border-primary/20 transition-all duration-200">
            <svg height="14" width="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
        </div>
      </div>
    </section>
  </Container>
</Layout>
