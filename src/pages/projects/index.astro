---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import { PROJECTS } from "@consts";

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div class="flex items-center gap-3 mb-8">
      <Breadcrumb />
    </div>
    <div class="space-y-10">
      <h1 class="page-title">{PROJECTS.TITLE}</h1>
      <p class="text-muted-fg">{PROJECTS.DESCRIPTION}</p>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl">
        {projects.map((project) => (
          <a
            href={`/${project.id}/`}
            class="card-glow block overflow-hidden glow-border group"
          >
            <!-- 项目配图 -->
            <div class="aspect-[16/10] bg-secondary overflow-hidden border-b border-border">
              <img
                src={`/images/${project.id}.svg`}
                alt={project.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src=`https://placehold.co/800x500/131928/22c55e?text=${encodeURIComponent(project.data.title)}`"
              >
            </div>
            <div class="p-6 space-y-3">
              <h3 class="text-xl font-bold text-foreground group-hover:text-primary transition-colors">
                {project.data.title}
              </h3>
              <p class="text-sm text-muted-fg leading-relaxed">
                {project.data.description}
              </p>
              <div class="flex items-center gap-2 text-sm text-primary pt-2">
                <span>打开项目</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </Container>
</Layout>
