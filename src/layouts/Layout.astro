---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  noNavPadding?: boolean;
  type?: "website" | "article";
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  image?: string;
};

const {
  title,
  description,
  noNavPadding = false,
  type = "website",
  publishedDate,
  modifiedDate,
  author,
  image,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      type={type}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      author={author}
      image={image}
    />
  </head>
  <body>
    <!-- Reading Progress Bar -->
    <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-primary z-[60] origin-left scale-x-0 transition-transform duration-100"></div>
    <noscript>
      <style>
        .animate, .scroll-section {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
    <Header hasHero={noNavPadding} />
    <main class:list={[!noNavPadding && "has-nav-padding"]}>
      <slot />
    </main>
    <Footer />
    <Pagefind />
  </body>
</html>
