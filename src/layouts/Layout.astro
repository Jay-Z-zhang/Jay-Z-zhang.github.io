---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  noNavPadding?: boolean;
  type?: "website" | "article";
  publishedDate?: string;
  modifiedDate?: string;
  author?: string;
  image?: string;
};

const {
  title,
  description,
  noNavPadding = false,
  type = "website",
  publishedDate,
  modifiedDate,
  author,
  image,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head
      title={`${title} | ${SITE.TITLE}`}
      description={description}
      type={type}
      publishedDate={publishedDate}
      modifiedDate={modifiedDate}
      author={author}
      image={image}
    />
  </head>
  <body>
    <!-- Reading Progress Bar -->
    <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-primary z-[60] origin-left scale-x-0 transition-transform duration-100"></div>
    <noscript>
      <style>
        .animate, .scroll-section {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>
    <Header hasHero={noNavPadding} />
    <main class:list={[!noNavPadding && "has-nav-padding"]} data-page-type={type}>
      <slot />
    </main>
    <Footer />
    <Pagefind />

    <script is:inline>
      // 阅读进度条 - 仅 article 页有效
      (function () {
        function initProgress() {
          const bar = document.getElementById("reading-progress");
          const main = document.querySelector("main[data-page-type]");
          if (!bar || !main || main.getAttribute("data-page-type") !== "article") {
            if (bar) bar.style.display = "none";
            return;
          }
          bar.style.display = "";
          function update() {
            const doc = document.documentElement;
            const scrollTop = window.scrollY || doc.scrollTop || 0;
            const totalScrollable = (doc.scrollHeight || 0) - window.innerHeight;
            if (totalScrollable <= 0) {
              bar.style.transform = "scaleX(1)";
              return;
            }
            const ratio = Math.min(Math.max(scrollTop / totalScrollable, 0), 1);
            bar.style.transform = "scaleX(" + ratio.toFixed(3) + ")";
          }
          window.addEventListener("scroll", update, { passive: true });
          window.addEventListener("resize", update);
          update();
        }
        document.addEventListener("DOMContentLoaded", initProgress);
        document.addEventListener("astro:after-swap", initProgress);
      })();
    </script>
  </body>
</html>
